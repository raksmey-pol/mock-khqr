# ---------------------------------------------------------------------------
# Mock store app environment
#
# Local development:  cp .env.example .env.local   (Next.js loads it for you)
# Docker deployment:  cp .env.example .env         (compose passes it via env_file)
# ---------------------------------------------------------------------------

# Bakong account that owns the QR (e.g. yourname@aclb)
BAKONG_ACCOUNT_ID=

# Merchant identity embedded in the KHQR (tags 59 / 60)
MERCHANT_NAME=Mock Merchant
MERCHANT_CITY=Phnom Penh

# Optional extra KHQR fields
# ACQUIRING_BANK=
# ACCOUNT_INFORMATION=
# MOBILE_NUMBER=
# STORE_LABEL=
# TERMINAL_LABEL=

# Secret used to verify signed payment webhooks (X-Webhook-Signature)
MERCHANT_WEBHOOK_SIGNING_SECRET=

# Set to false to accept webhook callbacks without a signature (testing only).
# Default: true — signatures are required.
# WEBHOOK_REQUIRE_SIGNATURE=true

# Optional: static token the Soramitsu Callback service must present as
# `Authorization: Bearer <token>` on /api/v1/transactions/callback.
# Leave empty to accept transaction callbacks without auth (testing).
# CALLBACK_AUTH_TOKEN=

# Optional: comma-separated browser origin allowlist for the /store/* API
# routes. Leave empty to allow all origins (localhost origins are always
# allowed).
WEB_ORIGIN=

# Optional: fallbacks used when the storefront omits these fields.
# Note: Bakong KHQR rules — KHR amounts must be whole numbers, USD allows up
# to 2 decimal places.
DEFAULT_CURRENCY=KHR
DEFAULT_EXPIRES_IN_MINUTES=3

# Optional: point the browser at a separately hosted mock API. Leave unset to
# use the API routes served by this same Next.js app (recommended).
# NEXT_PUBLIC_STORE_API_BASE_URL=
