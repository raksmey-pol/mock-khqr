# ---------------------------------------------------------------------------
# Mock store app environment
#
# Local development:  cp .env.example .env.local   (Next.js loads it for you)
# Docker deployment:  cp .env.example .env         (compose passes it via env_file)
# ---------------------------------------------------------------------------

# Open Banking backend base URL (no trailing slash)
OPEN_BANKING_BASE_URL=

# Merchant UUID registered in Open Banking (status = APPROVED)
MERCHANT_ID=

# Signing secrets from the Open Banking merchant record
MERCHANT_API_SIGNING_SECRET=
MERCHANT_WEBHOOK_SIGNING_SECRET=

# Optional: comma-separated browser origin allowlist for the /store/* API
# routes. Leave empty to allow all origins (localhost origins are always
# allowed).
WEB_ORIGIN=

# Optional: fallbacks used when the storefront omits these fields
DEFAULT_CURRENCY=KHR
DEFAULT_EXPIRES_IN_MINUTES=3

# Optional: point the browser at a separately hosted mock API. Leave unset to
# use the API routes served by this same Next.js app (recommended).
# NEXT_PUBLIC_STORE_API_BASE_URL=
